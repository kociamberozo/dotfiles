#!/bin/sh
set -eu

case "${1:-status}" in
    down)
        brightnessctl -q -d intel_backlight set 5%-
        ;;
    up)
        brightnessctl -q -d intel_backlight set +5%
        ;;
    status)
        ;;
    *)
        exit 2
        ;;
esac

current=$(cat /sys/class/backlight/intel_backlight/brightness)
maximum=$(cat /sys/class/backlight/intel_backlight/max_brightness)
percentage=$(( (current * 100 + maximum / 2) / maximum ))

printf 'BRI: %s%%\n' "$percentage" > "$HOME/.cache/i3-brightness"

pkill -USR1 i3status 2>/dev/null || true
